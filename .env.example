# ============================================================
# SHIKHO QA AUDIT MANAGEMENT SYSTEM — Environment Variables
# Copy to .env.local and fill in your values
# NEVER commit .env.local to git
#
# Vercel env var type guidance (see CLAUDE.md §14):
#   - Config type by default
#   - Secret type ONLY for SUPABASE_SERVICE_ROLE_KEY and CRM_BEARER_TOKEN
#     (Secret values can't be read back later — record them somewhere
#     safe outside Vercel if you need to double-check them)
# ============================================================

# Supabase (get from your Supabase project dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # Server-only, never expose — Secret type

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Shikho QA Audit Management System

# Email (Gmail SMTP)
GMAIL_SMTP_USER=your-gmail-address@shikho.com
GMAIL_SMTP_APP_PASSWORD=your-gmail-app-password
EMAIL_FROM=noreply@shikho.com
EMAIL_FROM_NAME=Shikho QA Audit Management System

# CRM lookup (§10 — lead/call-history integration)
CRM_BEARER_TOKEN=your-crm-api-bearer-token   # Secret type
CRM_API_BASE=https://crm-api.shikho.com   # domain root — the client appends /api/v1

# Call recordings (§10). The CRM returns only a FILENAME (e.g. server3-….mp3), not a URL.
# CRM_RECORDING_BASE_URL is where those files are hosted (https, or http://localhost for dev).
CRM_RECORDING_BASE_URL=
# none (default) or bearer — bearer sends CRM_BEARER_TOKEN, and only to the host above.
CRM_RECORDING_AUTH=

# Daily revenue sync cron (§8). Vercel sends this as "Authorization: Bearer <value>" to /api/cron/*.
# Any long random string; the route refuses to run if it is unset. Secret type on Vercel.
CRON_SECRET=
